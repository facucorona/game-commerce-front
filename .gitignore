node_modules
# build de producción (lo regenera CRA; nunca se versiona)
build/
# dotenv environment variables file
.env
.env.test
.vercel
# logs locales de desarrollo
*.log

# NOTA: package-lock.json NO está ignorado a propósito. El `overrides` de
# babel-preset-react-app y el legacy-peer-deps de .npmrc hacen que el árbol de
# dependencias sea delicado; sin el lock, Vercel lo resuelve de cero en cada
# build y el resultado depende de qué publique npm ese día.
# Ojo: si tocás package.json, regenerá el lock antes de pushear.
